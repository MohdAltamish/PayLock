{
  "name": "paylock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI escrow that pays on proof. Built on PayPal.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @paylock/api",
    "dev:api": "npm run dev -w @paylock/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "smoke": "tsx --env-file=.env scripts/paypal-smoke.ts",
    "webhook:register": "tsx --env-file=.env scripts/webhook-register.ts",
    "mcp:list-tools": "tsx --env-file=.env scripts/mcp-list-tools.ts",
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "20.19.43",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
