# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (docker compose up -d postgres) ---
DATABASE_URL=postgresql://paylock:paylock@localhost:5432/paylock

# --- PayPal (sandbox only) ---
# Sandbox REST app assigned to a US sandbox business account,
# with Payouts and Transaction Search enabled under Features.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Printed by `npm run webhook:register -- <public https url>`
PAYPAL_WEBHOOK_ID=
# Sandbox business account (receives captures, sends payouts)
PAYPAL_PLATFORM_EMAIL=
# Sandbox personal accounts used by smoke scripts and demo personas
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_SELLER_EMAIL=
# Hours a contract deadline may extend past authorization (ADR-001; set from sandbox observation)
AUTH_SAFE_WINDOW_HOURS=72

# --- LLM (Phase 3) ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=

# --- App ---
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# 32+ random characters; required in production. e.g. openssl rand -hex 32
SESSION_SECRET=
# 1 blocks every money write except void (incident kill switch)
PAYLOCK_FREEZE=0
