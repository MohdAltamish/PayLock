{
  "name": "@paylock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@paylock/schemas": "*",
    "@prisma/client": "6.19.3",
    "decimal.js": "10.6.0",
    "fastify": "5.12.8",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0",
    "tsup": "8.5.1"
  }
}
